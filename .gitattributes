# Auto detect text files and perform LF normalization
* text=auto

# === Source code — always LF ===
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.astro text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.xml   text eol=lf
*.sql   text eol=lf
*.py    text eol=lf
*.go    text eol=lf
*.sh    text eol=lf

# === Config & docs ===
*.md          text eol=lf
*.txt         text eol=lf
.editorconfig text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
Makefile      text eol=lf
Dockerfile    text eol=lf

# === Windows-specific (keep CRLF) ===
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# === Binary files ===
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.pdf   binary
*.zip   binary
*.gz    binary
bun.lockb    binary
package-lock.json -diff
yarn.lock    -diff
