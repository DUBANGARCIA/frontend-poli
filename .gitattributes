# Normalize line endings to LF on checkin; checkout native on Windows-only paths if needed.
* text=auto eol=lf

# Explicit text files (LF in repo)
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.json5     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.sass      text eol=lf
*.svg       text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
.gitignore  text eol=lf
.editorconfig text eol=lf

# Lockfiles — never auto-merge; treat as text but binary merge
bun.lock         text eol=lf merge=binary linguist-generated=true -diff
package-lock.json text eol=lf merge=binary linguist-generated=true -diff
yarn.lock        text eol=lf merge=binary linguist-generated=true -diff
pnpm-lock.yaml   text eol=lf merge=binary linguist-generated=true -diff

# Binary assets
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.avif      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.tar       binary
*.tar.gz    binary
*.tgz       binary

# Generated assets — exclude from language stats and diffs
dist/         linguist-generated=true
build/        linguist-generated=true
.angular/     linguist-generated=true
node_modules/ linguist-vendored=true
